<?xml version="1.0" encoding="utf-8"?>
<!--
    drawable/bg_badge.xml
    Pill-shaped background for the optional badge label (e.g. "Multi", "New").
    Text color and background tint are set per-badge in code via
    tvBadge.setTextColor(...) and tvBadge.setBackgroundTintList(...)
    using the color tokens in colors.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#E1F5EE" /><!-- overridden by backgroundTintList at runtime -->

    <corners android:radius="100dp" /><!-- full pill -->

</shape>
